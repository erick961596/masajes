# Postgres (Netlify DB / Neon). Usa la URL "pooled" para la app.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Secreto para firmar sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto"

# El correo que se registre con esta dirección será administrador.
ADMIN_EMAIL="tu-correo@ejemplo.com"

# URL pública del sitio (para los enlaces en los correos). En Netlify, si no la pones, se usa URL.
APP_URL="https://citas.tudominio.com"

# Zona horaria del negocio y moneda
BUSINESS_TZ="America/Costa_Rica"
CURRENCY="CRC"

# ---- Correo ----
# Opción A, lo más rápido para probar (sin crear cuenta): Ethereal crea una cuenta de prueba sola.
# Los correos NO llegan a nadie; en /admin/correo y en los logs ves un enlace para abrir cada correo.
# SMTP_HOST="ethereal"
#
# Opción B, Mailtrap Sandbox (gratis, todos los correos caen en un inbox de prueba en mailtrap.io):
# Mailtrap > Email Testing > Inboxes > tu inbox > Integration "SMTP" y copia usuario y contraseña.
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="tu-usuario-del-inbox"
SMTP_PASS="tu-password-del-inbox"
MAIL_FROM="Ani Spa <reservas@anispa.test>"
