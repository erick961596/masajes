# Postgres (Netlify DB / Neon). Usa la URL "pooled" para la app.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Secreto para firmar sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto"

# El correo que se registre con esta dirección será administrador.
ADMIN_EMAIL="tu-correo@ejemplo.com"

# URL pública del sitio (para los enlaces en los correos). En Netlify, si no la pones, se usa URL.
APP_URL="https://citas.tudominio.com"

# Zona horaria del negocio y moneda
BUSINESS_TZ="America/Mexico_City"
CURRENCY="MXN"
BUSINESS_NAME="Masajes"

# Mailtrap SMTP (Email Sending o Sandbox)
SMTP_HOST="live.smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="api"
SMTP_PASS="tu-token"
MAIL_FROM="Masajes <reservas@tudominio.com>"
