# Postgres (Netlify DB / Neon). Usa la URL "pooled" para la app.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Secreto para firmar sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto"

# El correo que se registre con esta dirección será administrador.
ADMIN_EMAIL="tu-correo@ejemplo.com"

# URL pública del sitio (para los enlaces en los correos). En Netlify, si no la pones, se usa URL.
APP_URL="https://citas.tudominio.com"

# Zona horaria del negocio y moneda
BUSINESS_TZ="America/Costa_Rica"
CURRENCY="CRC"

# ---- Correo (Mailtrap) ----
# API token de Mailtrap (Email Sending). Se usa live.smtp.mailtrap.io:587 con usuario "api".
# Sin token, la app cae a modo prueba con Ethereal (los correos no llegan a nadie).
MAILTRAP_TOKEN=""
# El remitente debe ser de un dominio verificado en Mailtrap → Sending Domains.
MAIL_FROM="Ani Spa <reservas@tudominio.com>"
# Opcional, para otro servidor (p. ej. Sandbox: sandbox.smtp.mailtrap.io, 2525, usuario/contraseña del inbox):
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
